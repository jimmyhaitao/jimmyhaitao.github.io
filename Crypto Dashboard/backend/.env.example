# ─── CEX API Keys (read-only permissions only!) ───────────────
# Coinbase Advanced Trade API (CDP format)
# Key name looks like: organizations/{org_id}/apiKeys/{key_id}
# Secret is the EC private key (paste the entire PEM block on one line, use \n for newlines)
COINBASE_API_KEY=organizations/your-org-id/apiKeys/your-key-id
COINBASE_API_SECRET=-----BEGIN EC PRIVATE KEY-----\nYourKeyHere\n-----END EC PRIVATE KEY-----\n

# OKX API
OKX_API_KEY=your_okx_api_key
OKX_API_SECRET=your_okx_api_secret
OKX_PASSPHRASE=your_okx_passphrase

# ─── Wallet Addresses ─────────────────────────────────────────
# Hyperliquid (EVM / HyperCore address)
HYPERLIQUID_ADDRESS=0xYourHyperliquidAddress

# Solana wallet (for Phantom + Kamino)
SOLANA_ADDRESS=YourSolanaPublicKey

# Ethereum wallet (for Metamask)
ETH_ADDRESS=0xYourEthereumAddress

# EVM address on Monad chain (for PancakeSwap V3 LP positions)
# If same as ETH_ADDRESS, you can omit this — it falls back to ETH_ADDRESS.
# BSC_ADDRESS=0xYourMonadAddress

# ─── Optional: Block Explorer API Keys (for token lists) ─────
# Free tier available at etherscan.io
ETHERSCAN_API_KEY=your_etherscan_api_key

# ─── Optional: Jupiter API Key (for Phantom token balances) ──
# Free at https://portal.jup.ag/api-keys — Ultra API filters scam tokens.
# Without this, Phantom falls back to RPC + verified mint whitelist.
# JUPITER_API_KEY=your_jupiter_api_key

# ─── Optional: Solana RPC (avoids rate-limiting) ─────────────
# The public Solana RPC is heavily rate-limited.
# SOLANA_RPC_URL=https://your-rpc-provider.com

# ─── Server Config ────────────────────────────────────────────
PORT=3001
